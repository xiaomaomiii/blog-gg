  "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>抖音去水印 (安卓直开版)</title>\n    <style>\n        /* 针对安卓机的基础样式优化 */\n        * { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }\n        body { font-family: sans-serif; background: #f2f3f5; margin: 0; padding: 15px; display: flex; justify-content: center; min-height: 100vh; align-items: flex-start; padding-top: 10vh; }\n        .card { background: #fff; border-radius: 16px; padding: 20px; width: 100%; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }\n        h2 { margin: 0 0 15px 0; font-size: 18px; text-align: center; color: #333; }\n        textarea { width: 100%; height: 90px; padding: 12px; border: 1px solid #ddd; border-radius: 10px; resize: none; font-size: 14px; background: #fafafa; outline: none; margin-bottom: 12px; }\n        textarea:focus { border-color: #fe2c55; background: #fff; }\n        button { background: #fe2c55; color: #fff; border: none; padding: 12px; border-radius: 10px; font-size: 16px; font-weight: bold; width: 100%; cursor: pointer; }\n        button:active { background: #e22449; }\n        button:disabled { background: #ff99a8; }\n        .error { color: #fe2c55; font-size: 13px; text-align: center; margin-top: 10px; display: none; }\n        #resultBox { display: none; margin-top: 20px; }\n        video { width: 100%; border-radius: 10px; background: #000; margin-bottom: 12px; max-height: 50vh; object-fit: contain; }\n        .btn-group { display: flex; gap: 10px; }\n        .btn-group a { flex: 1; text-align: center; text-decoration: none; padding: 10px; border-radius: 8px; font-size: 14px; color: #fff; }\n        .btn-open { background: #161823; }\n        .btn-down { background: #00c39a; }\n    </style>\n</head>\n<body>\n\n<div class=\"card\">\n    <h2>🎵 抖音无水印提取</h2>\n    <textarea id=\"shareInput\" placeholder=\"在此长按粘贴抖音文案...&#10;例：7.33 nOa:/ 只要把心态放平... https://v.douyin.com/xxxx/\"></textarea>\n    <button id=\"parseBtn\" onclick=\"startParse()\">一键提取视频</button>\n    <div id=\"errorMsg\" class=\"error\"></div>\n\n    <div id=\"resultBox\">\n        <video id=\"videoPlayer\" controls playsinline preload=\"auto\"></video>\n        <div class=\"btn-group\">\n            <a id=\"openBtn\" class=\"btn-open\" href=\"#\" target=\"_blank\">浏览器播放</a>\n            <a id=\"downBtn\" class=\"btn-down\" href=\"#\" target=\"_blank\">直接下载</a>\n        </div>\n    </div>\n</div>\n\n<script>\n    async function startParse() {\n        const input = document.getElementById('shareInput').value;\n        const btn = document.getElementById('parseBtn');\n        const errorMsg = document.getElementById('errorMsg');\n        const resultBox = document.getElementById('resultBox');\n        const videoPlayer = document.getElementById('videoPlayer');\n\n        const urlMatch = input.match(/(https?:\\/\\/[^\\s]+)/);\n        if (!urlMatch) {\n            showError(\"❌ 没找到链接，请检查粘贴的内容\");\n            return;\n        }\n        \n        btn.disabled = true;\n        btn.innerText = \"正在解析中...\";\n        errorMsg.style.display = \"none\";\n        resultBox.style.display = \"none\";\n\n        try {\n            // 使用免费接口\n            const apiUrl = `https://api.pearktrue.cn/api/douyin/?url=${encodeURIComponent(urlMatch[1])}`;\n            const response = await fetch(apiUrl);\n            const res = await response.json();\n\n            let finalUrl = \"\";\n            if (res.code === 200) finalUrl = res.data?.video || res.url || res.data?.url;\n\n            if (finalUrl) {\n                videoPlayer.src = finalUrl;\n                document.getElementById('openBtn').href = finalUrl;\n                document.getElementById('downBtn').href = finalUrl;\n                resultBox.style.display = \"block\";\n            } else {\n                showError(\"❌ 解析失败，接口异常或视频已删\");\n            }\n        } catch (error) {\n            showError(\"❌ 网络请求出错，请重试\");\n        } finally {\n            btn.disabled = false;\n            btn.innerText = \"一键提取视频\";\n        }\n    }\n\n    function showError(text) {\n        const errorMsg = document.getElementById('errorMsg');\n        errorMsg.innerText = text;\n        errorMsg.style.display = \"block\";\n    }\n</script>\n</body>\n</html>\n",
